# Sepolia RPC endpoint (get free one from alchemy.com or use public fallback)
SEPOLIA_RPC_URL=https://rpc.sepolia.org

# Program IDs (set after anchor build && anchor deploy)
SODA_PROGRAM_ID=Fg6PaFpoGXkYsidMpWTK6W2BeZ7FEfcYkg476zPFsLnS
ETH_DEMO_PROGRAM_ID=EtHD1gKbdD5tFzSHxDPF6TL1XvV3BZfhGkz1VzWt7kLb

# Signer keyshare path (generate with apps/signer/scripts/generate_keyshare.sh)
SIGNER_KEYSHARE_PATH=./keyshare.dev.json

# Solana RPC endpoints
SOLANA_RPC_URL=http://127.0.0.1:8899
SOLANA_WS_URL=ws://127.0.0.1:8900

# MPC committee (v0.5). Unset both to use the single-key k256 signer instead.
# MPC_COORDINATOR_TOKEN must match MPC_AUTH_TOKEN on the coordinator service.
MPC_COORDINATOR_URL=https://soda-mpc-coordinator.onrender.com
MPC_COORDINATOR_TOKEN=

# Which transaction the demo signs. Unset = 0.0001 ETH self-transfer.
#   DEMO_ACTION=aave  → Aave V3 WrappedTokenGatewayV3.depositETH on Sepolia;
#                       the derived address receives aWETH (a lending position
#                       owned by a Solana account). Needs ~0.0015 ETH of gas
#                       headroom, which the sponsor key tops up automatically.
# DEMO_ACTION=

# SOLANA_DEVNET_RPC_URL: use a real provider (e.g. a free Helius devnet key).
# The public https://api.devnet.solana.com endpoint returns 429 under the
# hundreds of chunked write transactions a program deploy makes, and a
# dropped chunk surfaces as "invalid program argument" on the final Upgrade —
# with ~1.4 SOL of buffer rent left stranded. Reads/demo runs are fine on it.

# Destination EVM chain for the demo: sepolia (default) | base-sepolia.
# The program is chain-agnostic; this picks the chain id, derivation tag,
# RPC, explorer and Aave contracts. Each chain has its OWN sponsor balance —
# the same sponsor key funds both, but SOL/ETH on one chain does not exist on
# the other. Distinct tags mean an owner's address differs per chain.
# DEMO_CHAIN=sepolia
# BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
