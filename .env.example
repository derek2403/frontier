# Repo-root environment for the CLI (./demo.sh, pnpm verify) and the
# services (signer, relayer, mpc-subscriber). Copy to .env; it is gitignored.
# The web app reads apps/web/.env instead — see apps/web/.env.example.

# ---- Chain ----------------------------------------------------------------
# Destination EVM chain: sepolia (default when unset) | base-sepolia.
# The program is chain-agnostic; this picks the chain id, derivation tag,
# RPC, explorer and Aave contracts. Distinct tags mean an owner's address
# differs per chain, and each chain needs its OWN sponsor balance.
DEMO_CHAIN=base-sepolia

# RPC for each chain. Keyless public nodes work; an Alchemy URL only serves
# the networks enabled on that app ("ETH_SEPOLIA is not enabled for this app"
# means the chain is switched off there, not that the code is wrong).
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# ---- Solana ---------------------------------------------------------------
# demo.sh picks SOLANA_DEVNET_RPC_URL for devnet (the default cluster) and
# http://127.0.0.1:8899 for SOLANA_CLUSTER=local. Use a real provider for
# devnet: the public endpoint 429s under a program deploy's hundreds of
# chunked writes, and a dropped chunk surfaces as "invalid program argument".
# Reads and demo runs are fine on the public endpoint.
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_DEVNET_RPC_URL=https://api.devnet.solana.com
# Some providers reject signatureSubscribe; demo.sh sets a per-cluster
# websocket, override here only if yours needs it.
# SOLANA_WS_URL=wss://api.devnet.solana.com
# ANCHOR_WALLET=  # unset = ~/.config/solana/id.json. Never hardcode a home dir.

# ---- Keys -----------------------------------------------------------------
# The v0 single-key signer lives at ./keyshare.dev.json (created on first
# run, gitignored). Its pubkey is the on-chain Committee.group_pk.

# Sponsor that tops up the derived address with gas, capped at 0.002 ETH per
# run. 32-byte hex, funded on DEMO_CHAIN. HOT WALLET — demo money only.
SEPOLIA_FUNDER_KEY=

# ---- MPC committee (v0.5) — leave unset for the demo ----------------------
# Setting MPC_COORDINATOR_URL switches demo.ts and the web to the Lindell '17
# committee. It cannot apply the per-owner derivation tweak yet, and its
# group_pk differs from the on-chain committee, so every signature is
# rejected with PubkeyMismatch. MPC_COORDINATOR_TOKEN must match the
# coordinator's MPC_AUTH_TOKEN.
# MPC_COORDINATOR_URL=https://soda-mpc.onrender.com
# MPC_COORDINATOR_TOKEN=
