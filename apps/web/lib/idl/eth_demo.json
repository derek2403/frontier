          "writable": true,
          "signer": true
        },
        {
          "name": "committee"
        },
        {
          "name": "sig_request",
          "writable": true
        },
        {
          "name": "soda_program"
        },
        {
          "name": "system_program",
          "address": "11111111111111111111111111111111"
        }
      ],
