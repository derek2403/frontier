# apps/web environment. Copy to apps/web/.env for local `pnpm --filter web dev`;
# set the same names in the Vercel project for a deployment.
#
# Two kinds of variable:
#   NEXT_PUBLIC_*  are inlined into the browser bundle AT BUILD TIME. Changing
#                  one on Vercel needs a redeploy, not just a restart.
#   everything else is read by the API routes (server) at request time.

# ---- Chain -----------------------------------------------------------------
# Destination EVM chain: sepolia | base-sepolia. Both must be the SAME value —
# the browser derives the address and builds the tx for NEXT_PUBLIC_DEMO_CHAIN,
# the server funds and broadcasts on DEMO_CHAIN. The page refuses to run if
# they differ. DEMO_CHAIN may be omitted; the server then uses the public one.
NEXT_PUBLIC_DEMO_CHAIN=base-sepolia
DEMO_CHAIN=base-sepolia

# RPC for that chain. Browser (balance polling, nonce, gas price) and server
# (funding, broadcast) each need one; they can be the same URL. An Alchemy
# app only serves the networks enabled on it — "ETH_SEPOLIA is not enabled
# for this app" means this URL's app does not have the chain switched on.
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=https://base-sepolia.g.alchemy.com/v2/<key>
BASE_SEPOLIA_RPC_URL=https://base-sepolia.g.alchemy.com/v2/<key>
# For DEMO_CHAIN=sepolia use these instead:
# NEXT_PUBLIC_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# ---- Sui (pages/sui.tsx + /api/sui/*) -------------------------------------
# Sui network: sui-testnet | sui-devnet. Same rule as the EVM pair above: the
# browser derives and builds for NEXT_PUBLIC_SUI_CHAIN, the server funds and
# submits on SUI_CHAIN, and /api/sui/* refuse a request from a page built for
# the other one. SUI_CHAIN may be omitted; the server then uses the public one.
# Unset = sui-testnet, matching the CLI's default.
NEXT_PUBLIC_SUI_CHAIN=sui-testnet
SUI_CHAIN=sui-testnet

# GraphQL endpoint for that network. Optional: the default is Mysten's public
# GraphQL (https://graphql.testnet.sui.io/graphql), which needs no key and
# allows browser requests. Override only to point at your own indexer.
# Browser (balance, gas coins, simulation):
# NEXT_PUBLIC_SUI_GRAPHQL_URL=https://graphql.testnet.sui.io/graphql
# Server (funding, executeTransaction); one per network:
# SUI_TESTNET_GRAPHQL_URL=https://graphql.testnet.sui.io/graphql
# SUI_DEVNET_GRAPHQL_URL=https://graphql.devnet.sui.io/graphql

# Sponsor that tops derived Sui addresses up with gas (capped at 0.1 SUI per
# run): a 32-byte secp256k1 hex key holding SUI on SUI_CHAIN. Demo money only.
# When it is unset or empty, /api/sui/fund asks the public testnet faucet
# instead, which rate-limits per IP; the page then names the address to fund
# by hand at https://faucet.sui.io.
# SUI_FUNDER_KEY=

# ---- Solana ----------------------------------------------------------------
# Browser: Phantom's connection + sign_eth_transfer confirmation.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
# Server: /api/finalize submits finalize_signature and reads the committee.
# If this provider rejects signatureSubscribe (Alchemy's Solana endpoint
# does), also set SOLANA_WS_URL to a websocket that accepts it.
SOLANA_RPC_URL=https://api.devnet.solana.com
# SOLANA_WS_URL=wss://api.devnet.solana.com
#
# Solami (mainnet ONLY — it has no devnet; switch here only once the programs
# are deployed to mainnet). HTTP and WebSocket live on different hosts, so
# SOLANA_WS_URL must be set or onLogs/signatureSubscribe silently never fire.
# Verified 2026-10-11: logsSubscribe and signatureSubscribe both work.
#   SOLANA_RPC_URL=https://rpc.solami.dev/solana/ams?api-key=<SOLAMI_API_KEY>
#   SOLANA_WS_URL=wss://ws.solami.dev/ws/sol?api_key=<SOLAMI_API_KEY>
#   gRPC: grpc.solami.dev:443, header x-token: <SOLAMI_API_KEY>
#
# The browser copies are baked into the public JS bundle. Use a SEPARATE
# Solami RPC key created as "Frontend only" with a domain allowlist
# (sodalabs.org, www.sodalabs.org) — never the unrestricted server key.
#   NEXT_PUBLIC_SOLANA_RPC_URL=https://rpc.solami.dev/solana/ams?api-key=<SOLAMI_BROWSER_RPC_KEY>
#   NEXT_PUBLIC_SOLANA_WS_URL=wss://ws.solami.dev/ws/sol?api_key=<SOLAMI_BROWSER_RPC_KEY>

# ---- Solana cluster + program ids (mainnet) --------------------------------
# Unset = devnet: the program ids come from lib/idl/*.json and the Solana
# transaction links carry ?network=devnet. The program code is identical on
# both clusters, so mainnet only swaps the ids. All four are inlined at BUILD
# time and are read by the API routes too, so set them before `next build`
# (on Railway they are Dockerfile ARGs) and redeploy after a change.
#
# Cluster for the Solana links and the "Phantom on <cluster>" text:
# devnet | testnet | mainnet-beta. mainnet-beta drops the cluster parameter,
# which explorers read as mainnet. It does NOT pick the RPC; set
# NEXT_PUBLIC_SOLANA_RPC_URL / SOLANA_RPC_URL to a mainnet endpoint as well.
# NEXT_PUBLIC_SOLANA_CLUSTER=mainnet-beta
#
# Mainnet program ids (devnet ids: soda CPAEfBXp…AL1J, eth_demo 9JMr3TNH…BBXx).
# NEXT_PUBLIC_SODA_PROGRAM_ID=afbLp3atZ9J6w1PjCsgGx7ALrgBVuMvcJPmwczTrQw3
# NEXT_PUBLIC_ETH_DEMO_PROGRAM_ID=DZaBAkQac4DTwoXcoCuMDa76onxAdN6im3s5jcrV5GSw
# The mainnet deploy covers soda and eth_demo only. Set this once sui_demo is
# deployed there; until then the Sui page keeps the devnet id and will not
# work against a mainnet RPC.
# NEXT_PUBLIC_SUI_DEMO_PROGRAM_ID=

# ---- Server keys -----------------------------------------------------------
# Solana payer for finalize_signature. Locally the file at ANCHOR_WALLET (or
# ~/.config/solana/id.json) is used; on Vercel there is no file, so inline the
# keypair JSON (the 64-number array) here.
# ANCHOR_WALLET_JSON=[12,34,...]

# The v0 single-key signer: the secp256k1 key whose pubkey is the on-chain
# Committee.group_pk. Locally the file keyshare.dev.json at the repo root is
# used; on Vercel there is no file, so inline the 32-byte hex here. It MUST be
# the same key that ran init_committee, or /api/finalize refuses to sign.
# SODA_SIGNER_KEY_HEX=

# Sponsor key that tops up derived addresses with gas (capped at 0.002 ETH
# per run). Needs a balance on DEMO_CHAIN specifically. Demo money only.
SEPOLIA_FUNDER_KEY=

# ---- MPC committee ---------------------------------------------------------
# Setting MPC_COORDINATOR_URL switches /api/finalize and /api/sui/finalize to
# the Lindell '17 committee on Railway. The nodes derive the tweak from the
# on-chain request themselves and fold it into the signed message, so the
# signature recovers to the per-owner derived address. The on-chain
# Committee.group_pk must be the committee's key (update_committee), or
# finalize_signature rejects with PubkeyMismatch. There is no NEXT_PUBLIC_
# copy: the page reports whatever the server actually uses. Unset = the v0
# single key in SODA_SIGNER_KEY_HEX.
# MPC_COORDINATOR_URL=https://soda-mpc-coordinator-production.up.railway.app
# MPC_COORDINATOR_TOKEN=
