{
  "name": "relayer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SODA relayer — listens for SigCompleted plus EthTxRequested / SuiTxRequested events on Solana and submits the assembled signed tx to Sepolia or Sui.",
  "scripts": {
    "dev": "tsx src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test src/events.test.ts"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.32.1",
    "@noble/curves": "^1.6.0",
    "@solana/web3.js": "^1.95.0",
    "@soda-sdk/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
